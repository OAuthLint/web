---
import SiteChrome from '../../components/SiteChrome.astro';
import Base from '../../layouts/Base.astro';
import { renderInline, stripInline } from '../../lib/inline';
import { type Severity, getRules } from '../../lib/rules';

const rules = getRules();

// --- Topic (category) taxonomy -------------------------------------------
// `rule.category` (from rules.ts) is language-prefixed for non-JS rules
// (e.g. `py-jwt`, `csharp-oauth`), which is too granular for a catalogue
// filter. Every rule id is `auth.<topic>.<name>` (JS/TS, the default
// language) or `auth.<lang>.<topic>.<name>` (every other language) — the
// topic is always the second-to-last id segment, so it gives a clean,
// language-independent category regardless of id shape.
const TOPIC_LABEL: Record<string, string> = {
  jwt: 'JWT',
  oauth: 'OAuth',
  oidc: 'OIDC',
  flow: 'Flow',
  cookie: 'Cookies',
  crypto: 'Crypto',
  cors: 'CORS',
  mcp: 'MCP',
  android: 'Android',
  secret: 'Secrets',
  web: 'Web',
  tls: 'TLS',
  session: 'Session',
  nextauth: 'NextAuth',
  iac: 'IaC',
  express: 'Express',
  fastify: 'Fastify',
  fastapi: 'FastAPI',
  betterauth: 'BetterAuth',
  nestjs: 'NestJS',
  hono: 'Hono',
  drf: 'DRF',
  storage: 'Storage',
  passport: 'Passport',
  keychain: 'Keychain',
  flask: 'Flask',
  django: 'Django',
};
function topicSlug(id: string): string {
  const parts = id.split('.');
  return parts.length >= 2 ? (parts[parts.length - 2] ?? 'misc') : 'misc';
}
function topicLabel(slug: string): string {
  return TOPIC_LABEL[slug] ?? slug.charAt(0).toUpperCase() + slug.slice(1);
}

// --- Language display ------------------------------------------------------
// `js` and `ts` almost always ship together (a Semgrep rule targeting one
// nearly always targets both); the catalogue reads better collapsing them
// into one "js / ts" group, both in the filter and in each row.
function shortLangs(langs: string[]): string {
  const hasJs = langs.includes('js');
  const hasTs = langs.includes('ts');
  const rest = langs.filter((l) => l !== 'js' && l !== 'ts');
  const parts = hasJs && hasTs ? ['js / ts'] : hasJs ? ['js'] : hasTs ? ['ts'] : [];
  return [...parts, ...rest].join(' · ');
}

const LANG_FILTER_LABEL: Record<string, string> = {
  'js-ts': 'JS / TypeScript',
  python: 'Python',
  go: 'Go',
  java: 'Java',
  rust: 'Rust',
  csharp: 'C# / .NET',
  php: 'PHP',
  ruby: 'Ruby',
  kotlin: 'Kotlin',
  swift: 'Swift / iOS',
  xml: 'XML',
};
const LANG_ORDER = [
  'js-ts',
  'python',
  'go',
  'java',
  'rust',
  'csharp',
  'php',
  'ruby',
  'kotlin',
  'swift',
  'xml',
];

// Derive filter options from the data, nothing frozen in prose.
const presentLangsRaw = new Set(rules.flatMap((r) => r.languages));
const langValues = new Set<string>();
if (presentLangsRaw.has('js') || presentLangsRaw.has('ts')) langValues.add('js-ts');
for (const l of presentLangsRaw) if (l !== 'js' && l !== 'ts') langValues.add(l);
const langOptions = [
  ...LANG_ORDER.filter((l) => langValues.has(l)),
  ...[...langValues].filter((l) => !LANG_ORDER.includes(l)).sort(),
];

const catValues = new Set(rules.map((r) => topicSlug(r.id)));
const catOptions = [...catValues].sort((a, b) => topicLabel(a).localeCompare(topicLabel(b)));

// Severity presentation: title-case label + design token, keyed by design severity.
const SEV: Record<Severity, { label: string; color: string }> = {
  critical: { label: 'Critical', color: 'var(--ol-sev-critical)' },
  high: { label: 'High', color: 'var(--ol-sev-high)' },
  medium: { label: 'Medium', color: 'var(--ol-sev-medium)' },
  low: { label: 'Low', color: 'var(--ol-sev-low)' },
  info: { label: 'Info', color: 'var(--ol-sev-info)' },
};
// Fixed chip set (All / Critical / High / Medium / Low), matching the design.
const SEV_CHIPS: Severity[] = ['critical', 'high', 'medium', 'low'];

// Dataflow (taint) rules — OAuthLint's technical differentiator: they trace
// untrusted/sensitive data from a source to a dangerous sink (taint analysis),
// catching multi-line bugs that single-line pattern rules miss. The rule loader
// doesn't yet surface each rule's analysis `mode`, so we carry the known taint
// set (the rules whose YAML declares `mode: taint`).
const TAINT_RULE_IDS = new Set<string>([
  'auth.flow.open-redirect',
  'auth.flow.secret-in-response',
  'auth.flow.ssrf',
  'auth.go.flow.open-redirect',
  'auth.go.flow.secret-in-response',
  'auth.go.flow.ssrf',
  'auth.oauth.open-redirect-callback',
  'auth.py.flow.open-redirect',
  'auth.py.flow.secret-in-response',
  'auth.py.flow.ssrf',
]);
const isTaint = (id: string): boolean => TAINT_RULE_IDS.has(id);
const taintCount = rules.filter((r) => isTaint(r.id)).length;

const PAGE_SIZE = 8;
---
<Base
  title="Rules · OAuthLint"
  description="Browse the OAuthLint rule pack. Filter auth anti-pattern rules by language, category and severity. Every rule maps to a CWE and ships a vulnerable and a safe example."
>
  <SiteChrome active="rules">
    <main style="max-width:1120px; margin:0 auto; padding:var(--ol-space-12) var(--ol-space-6) var(--ol-space-20);">
      <h1 style="font-family:var(--ol-font-display); font-weight:700; font-size:var(--ol-text-display-l); letter-spacing:-0.03em; margin:0 0 var(--ol-space-3);">Every rule earns its place.</h1>
      <p style="font-size:var(--ol-text-body-l); line-height:var(--ol-leading-relaxed); color:var(--ol-text-secondary); max-width:60ch; margin:0 0 var(--ol-space-4);">Each rule maps to a CWE and ships a vulnerable and a safe example. All of them run in the CLI, in CI and on every pull request.</p>
      <p style="margin:0 0 var(--ol-space-8);"><a href="/owasp" style="font-family:var(--ol-font-mono); font-size:12px; font-weight:600; letter-spacing:0.04em; color:var(--ol-accent); text-decoration:none;">OWASP coverage →</a></p>

      <!-- DATAFLOW EXPLAINER -->
      {taintCount > 0 && (
        <div style="display:flex; gap:12px; align-items:flex-start; padding:14px 16px; margin-bottom:var(--ol-space-6); background:var(--ol-surface); border:1px solid var(--ol-border); border-left:2px solid var(--ol-accent); border-radius:3px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ol-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto; margin-top:1px;"><path d="M4 7h11"></path><path d="M4 7l3-3M4 7l3 3"></path><path d="M20 17H9"></path><path d="M20 17l-3-3M20 17l-3 3"></path></svg>
          <p style="font-size:var(--ol-text-body-s); line-height:1.6; color:var(--ol-text-secondary); margin:0;"><span style="color:var(--ol-text); font-weight:600;">Dataflow analysis.</span> {taintCount} rules run in dataflow (taint) mode — OAuthLint traces untrusted input and sensitive data from source to a dangerous sink, catching multi-line bugs that pattern rules miss. <a href="/research" style="color:var(--ol-accent); text-decoration:none; white-space:nowrap;">See the proof →</a></p>
        </div>
      )}

      <!-- CONTROLS -->
      <div role="search" style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:var(--ol-space-4);">
        <label style="display:flex; align-items:center; gap:9px; width:320px; max-width:100%; height:34px; padding:0 11px; background:var(--ol-surface); border:1px solid var(--ol-border-strong); border-radius:3px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" style="flex:0 0 auto; color:var(--ol-text-muted);"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <input id="rule-search" type="search" placeholder="Search by rule or title" aria-label="Search rules" style="flex:1; min-width:0; background:transparent; border:0; outline:0; color:var(--ol-text); font-family:var(--ol-font-ui); font-size:14px;" />
        </label>

        <span style="position:relative; display:inline-flex;">
          <select id="rule-lang" aria-label="Filter by language" style="appearance:none; height:34px; padding:0 32px 0 12px; background:var(--ol-surface); border:1px solid var(--ol-border-strong); border-radius:3px; color:var(--ol-text); font-family:var(--ol-font-ui); font-size:14px; cursor:pointer;">
            <option value="all">All languages</option>
            {langOptions.map((l) => <option value={l}>{LANG_FILTER_LABEL[l] ?? l}</option>)}
          </select>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); pointer-events:none; color:var(--ol-text-muted);"><path d="M6 9l6 6 6-6"></path></svg>
        </span>

        <span style="position:relative; display:inline-flex;">
          <select id="rule-cat" aria-label="Filter by category" style="appearance:none; height:34px; padding:0 32px 0 12px; background:var(--ol-surface); border:1px solid var(--ol-border-strong); border-radius:3px; color:var(--ol-text); font-family:var(--ol-font-ui); font-size:14px; cursor:pointer;">
            <option value="all">All categories</option>
            {catOptions.map((c) => <option value={c}>{topicLabel(c)}</option>)}
          </select>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); pointer-events:none; color:var(--ol-text-muted);"><path d="M6 9l6 6 6-6"></path></svg>
        </span>

        <div role="group" aria-label="Filter by severity" style="display:flex; flex-wrap:wrap; gap:6px; margin-left:4px;">
          <button type="button" data-sev="all" aria-pressed="true" class="rule-chip is-active">All</button>
          {SEV_CHIPS.map((s) => (
            <button type="button" data-sev={s} aria-pressed="false" class="rule-chip">{SEV[s].label}</button>
          ))}
        </div>

        {taintCount > 0 && (
          <button id="rule-flow" type="button" aria-pressed="false" class="rule-flowbtn" title="Show only dataflow (taint) rules — those that trace data from source to sink">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h11"></path><path d="M4 7l3-3M4 7l3 3"></path><path d="M20 17H9"></path><path d="M20 17l-3-3M20 17l-3 3"></path></svg>
            DATAFLOW
          </button>
        )}
      </div>

      <!-- TABLE -->
      <div style="border:1px solid var(--ol-border); border-radius:3px; overflow:hidden; background:var(--ol-surface);">
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; table-layout:fixed; min-width:720px;">
            <caption class="visually-hidden">OAuthLint rules</caption>
            <thead>
              <tr>
                <th scope="col" style="width:50%; text-align:left; padding:10px 16px; font-size:12px; font-weight:600; color:var(--ol-text-muted); background:var(--ol-surface-raised); border-bottom:1px solid var(--ol-border);">Rule</th>
                <th scope="col" style="width:12%; text-align:left; padding:10px 16px; font-size:12px; font-weight:600; color:var(--ol-text-muted); background:var(--ol-surface-raised); border-bottom:1px solid var(--ol-border);">Severity</th>
                <th scope="col" style="width:12%; text-align:left; padding:10px 16px; font-size:12px; font-weight:600; color:var(--ol-text-muted); background:var(--ol-surface-raised); border-bottom:1px solid var(--ol-border);">Category</th>
                <th scope="col" style="text-align:left; padding:10px 16px; font-size:12px; font-weight:600; color:var(--ol-text-muted); background:var(--ol-surface-raised); border-bottom:1px solid var(--ol-border);">Languages</th>
                <th scope="col" style="width:44px; text-align:left; padding:10px 16px; font-size:12px; font-weight:600; color:var(--ol-text-muted); background:var(--ol-surface-raised); border-bottom:1px solid var(--ol-border);"><span class="visually-hidden">Open</span></th>
              </tr>
            </thead>
            <tbody id="rule-rows">
              {rules.map((r) => {
                const cat = topicSlug(r.id);
                return (
                  <tr
                    data-row
                    data-id={r.slug}
                    data-title={stripInline(r.title).toLowerCase()}
                    data-sev={r.severity}
                    data-cat={cat}
                    data-langs={r.languages.join(' ')}
                    data-flow={isTaint(r.id) ? 'true' : 'false'}
                    class="rule-row"
                  >
                    <td style="padding:13px 16px; border-bottom:1px solid var(--ol-border-subtle);">
                      <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                        <a href={`/rules/${r.slug}`} class="rule-row-link" style="font-family:var(--ol-font-mono); font-size:13px; font-weight:600; color:var(--ol-accent);">{r.slug}</a>
                        {isTaint(r.id) && (
                          <span title="Dataflow rule — traces untrusted/sensitive data from source to a dangerous sink" style="display:inline-flex; align-items:center; gap:4px; font-family:var(--ol-font-mono); font-size:9px; font-weight:600; letter-spacing:0.06em; color:var(--ol-accent); border:1px solid var(--ol-accent-800); border-radius:2px; padding:1px 5px; line-height:1.4;">
                            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h11"></path><path d="M4 7l3-3M4 7l3 3"></path><path d="M20 17H9"></path><path d="M20 17l-3-3M20 17l-3 3"></path></svg>
                            DATAFLOW
                          </span>
                        )}
                      </div>
                      <div style="font-size:13.5px; line-height:1.45; color:var(--ol-text-secondary);" set:html={renderInline(r.title)} />
                    </td>
                    <td style={`padding:13px 16px; border-bottom:1px solid var(--ol-border-subtle); font-size:13px; font-weight:600; color:${SEV[r.severity].color}; white-space:nowrap;`}>{SEV[r.severity].label}</td>
                    <td style="padding:13px 16px; border-bottom:1px solid var(--ol-border-subtle); font-size:13px; color:var(--ol-text-secondary);">{topicLabel(cat)}</td>
                    <td style="padding:13px 16px; border-bottom:1px solid var(--ol-border-subtle); font-size:13px; color:var(--ol-text-secondary);">{shortLangs(r.languages)}</td>
                    <td style="padding:13px 16px; border-bottom:1px solid var(--ol-border-subtle); text-align:right; color:var(--ol-text-faint);">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p id="rule-empty" hidden style="font-size:13px; color:var(--ol-text-muted); padding:24px 16px; margin:0; text-align:center;">No rules match these filters.</p>

        <!-- PAGINATION -->
        <div id="rule-pager" style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 16px; border-top:1px solid var(--ol-border);">
          <span id="rule-count-label" role="status" class="tnum" style="font-size:13px; color:var(--ol-text-muted); font-variant-numeric:tabular-nums;">1–{Math.min(PAGE_SIZE, rules.length)} of {rules.length}</span>
          <div style="display:flex; gap:8px;">
            <button id="rule-prev" type="button" aria-label="Previous page" class="rule-pagebtn" disabled aria-disabled="true">Previous</button>
            <button id="rule-next" type="button" aria-label="Next page" class="rule-pagebtn">Next</button>
          </div>
        </div>
      </div>
    </main>
  </SiteChrome>

  <script define:vars={{ PAGE_SIZE }} is:inline>
    (() => {
      const search = document.getElementById('rule-search');
      const langSel = document.getElementById('rule-lang');
      const catSel = document.getElementById('rule-cat');
      const rows = Array.from(document.querySelectorAll('[data-row]'));
      const empty = document.getElementById('rule-empty');
      const chips = Array.from(document.querySelectorAll('[data-sev]'));
      const countLabel = document.getElementById('rule-count-label');
      const prevBtn = document.getElementById('rule-prev');
      const nextBtn = document.getElementById('rule-next');
      const flowBtn = document.getElementById('rule-flow');
      let sev = 'all';
      let flowOnly = false;
      let page = 1;

      function matchLang(row, lang) {
        if (lang === 'all') return true;
        const langs = row.dataset.langs.split(' ');
        if (lang === 'js-ts') return langs.includes('js') || langs.includes('ts');
        return langs.includes(lang);
      }

      function matches(row) {
        const q = (search.value || '').trim().toLowerCase();
        const matchQ = !q || row.dataset.id.includes(q) || row.dataset.title.includes(q);
        const matchLng = matchLang(row, langSel.value);
        const matchCat = catSel.value === 'all' || row.dataset.cat === catSel.value;
        const matchSev = sev === 'all' || row.dataset.sev === sev;
        const matchFlow = !flowOnly || row.dataset.flow === 'true';
        return matchQ && matchLng && matchCat && matchSev && matchFlow;
      }

      function setDisabled(btn, disabled) {
        btn.disabled = disabled;
        btn.setAttribute('aria-disabled', String(disabled));
      }

      // Filter, then paginate the filtered subset.
      function render() {
        const filtered = rows.filter(matches);
        const total = filtered.length;
        const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));
        if (page > pageCount) page = pageCount;
        if (page < 1) page = 1;
        const start = (page - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;

        for (const row of rows) row.hidden = true;
        for (let i = start; i < end && i < total; i++) filtered[i].hidden = false;

        countLabel.textContent =
          total === 0 ? '0 of 0' : `${start + 1}–${Math.min(end, total)} of ${total}`;
        empty.hidden = total !== 0;
        setDisabled(prevBtn, page <= 1);
        setDisabled(nextBtn, page >= pageCount);
      }

      function onFilterChange() {
        page = 1;
        render();
      }

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          sev = chip.dataset.sev;
          for (const c of chips) {
            const active = c === chip;
            c.setAttribute('aria-pressed', String(active));
            c.classList.toggle('is-active', active);
          }
          onFilterChange();
        });
      }

      if (flowBtn) {
        flowBtn.addEventListener('click', () => {
          flowOnly = !flowOnly;
          flowBtn.setAttribute('aria-pressed', String(flowOnly));
          flowBtn.classList.toggle('is-active', flowOnly);
          onFilterChange();
        });
      }

      prevBtn.addEventListener('click', () => {
        if (page > 1) {
          page--;
          render();
        }
      });
      nextBtn.addEventListener('click', () => {
        page++;
        render();
      });

      search.addEventListener('input', onFilterChange);
      langSel.addEventListener('change', onFilterChange);
      catSel.addEventListener('change', onFilterChange);

      render();
    })();
  </script>

  <style>
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .rule-chip {
      display: inline-flex;
      align-items: center;
      height: 34px;
      padding: 0 12px;
      border-radius: 3px;
      font-family: var(--ol-font-ui);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      color: var(--ol-text-muted);
      background: var(--ol-surface);
      border: 1px solid var(--ol-border);
      transition:
        background var(--ol-dur-fast) var(--ol-ease-standard),
        border-color var(--ol-dur-fast) var(--ol-ease-standard),
        color var(--ol-dur-fast) var(--ol-ease-standard);
    }
    .rule-chip.is-active {
      color: var(--ol-accent);
      background: var(--ol-accent-subtle);
      border-color: var(--ol-accent-border);
    }
    /* Dataflow (taint) mode toggle — a distinct mono chip, not a severity. */
    .rule-flowbtn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 34px;
      padding: 0 12px;
      margin-left: 4px;
      border-radius: 3px;
      font-family: var(--ol-font-mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      color: var(--ol-text-muted);
      background: var(--ol-surface);
      border: 1px solid var(--ol-border-strong);
      transition:
        background var(--ol-dur-fast) var(--ol-ease-standard),
        border-color var(--ol-dur-fast) var(--ol-ease-standard),
        color var(--ol-dur-fast) var(--ol-ease-standard);
    }
    .rule-flowbtn:hover {
      color: var(--ol-text);
      border-color: var(--ol-accent-border);
    }
    .rule-flowbtn.is-active {
      color: var(--ol-accent);
      background: var(--ol-accent-subtle);
      border-color: var(--ol-accent-border);
    }
    .rule-pagebtn {
      display: inline-flex;
      align-items: center;
      height: 30px;
      padding: 0 12px;
      background: var(--ol-surface-raised);
      border: 1px solid var(--ol-border-strong);
      border-radius: 3px;
      font-family: var(--ol-font-ui);
      font-size: 13px;
      font-weight: 600;
      color: var(--ol-text-secondary);
      cursor: pointer;
    }
    .rule-pagebtn:disabled {
      color: var(--ol-text-faint);
      cursor: not-allowed;
      opacity: 0.6;
    }
    .rule-row {
      position: relative;
      transition: background var(--ol-dur-fast) var(--ol-ease-standard);
    }
    .rule-row:hover {
      background: var(--ol-surface-raised);
    }
    .rule-row-link {
      color: inherit;
      text-decoration: none;
    }
    /* Stretched-link: the row's only real, keyboard-focusable link is the
       title anchor; this extends its hit area to the full row so the whole
       row is clickable without adding a non-semantic click handler. */
    .rule-row-link::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .rule-row-link:focus-visible {
      outline: none;
    }
    .rule-row-link:focus-visible::after {
      outline: 2px solid var(--ol-focus-ring);
      outline-offset: -2px;
    }
  </style>

  <style is:global>
    /* Inline `code` spans in a catalogue row's title, emitted by
       renderInline() via set:html (global, since scoped styles do not reach
       set:html content). Quiet mono so it reads as code, not a heavy chip. */
    .rule-row-link code {
      font-family: var(--ol-font-mono);
      font-size: 0.9em;
      color: var(--ol-text);
    }
  </style>
</Base>
