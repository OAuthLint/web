---
import { ArrowLeft, ArrowRight, ArrowUpRight, Search, X } from '@lucide/astro';
import SeverityBadge from '../../components/SeverityBadge.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Base from '../../layouts/Base.astro';
import {
  catalogueEntry,
  languageLabel,
  ruleTitle,
  topicLabel,
  topicSlug,
} from '../../lib/catalogue';
import { SEVERITIES, getRules } from '../../lib/rules';
const rules = getRules();
const TAINT_RULE_IDS = new Set<string>([
  'auth.flow.open-redirect',
  'auth.flow.secret-in-response',
  'auth.flow.ssrf',
  'auth.go.flow.open-redirect',
  'auth.go.flow.secret-in-response',
  'auth.go.flow.ssrf',
  'auth.oauth.open-redirect-callback',
  'auth.py.flow.open-redirect',
  'auth.py.flow.secret-in-response',
  'auth.py.flow.ssrf',
]);
const isTaint = (id: string): boolean => TAINT_RULE_IDS.has(id);
const PAGE_SIZE = 8;
const languages = [...new Set(rules.flatMap((rule) => rule.languages))].sort((a, b) =>
  languageLabel(a).localeCompare(languageLabel(b)),
);
const categories = [...new Set(rules.map((rule) => topicSlug(rule.id)))].sort((a, b) =>
  topicLabel(a).localeCompare(topicLabel(b)),
);
const taintCount = rules.filter((r) => isTaint(r.id)).length;
---
<Base title="Rule catalogue | OAuthLint" description="Search every OAuthLint rule by ID, language, topic or severity. Inspect vulnerable and corrected examples, dataflow analysis and CWE/OWASP references.">
  <SiteChrome active="rules">
    <main id="main" class="container catalogue" data-pagefind-body>
      <header class="page-heading catalogue-heading"><div><p class="eyebrow">Open-source rule reference</p><h1>Rule catalogue</h1><p>Find the diagnostic. Understand the risk. Make the fix.</p></div><a class="text-link" href="/owasp">OWASP mapping <ArrowUpRight size={15} aria-hidden="true" /></a></header>
      <div class="catalogue-toolbar" data-pagefind-ignore>
        <form id="rule-filters" role="search" aria-label="Filter rules">
          <label class="rule-search"><Search size={20} aria-hidden="true" /><span class="sr-only">Search rules</span><input id="rule-search" name="q" type="search" placeholder="Search by rule ID, keyword, CWE..." autocomplete="off" maxlength="200" /></label>
          <div class="filter-controls">
            <label><span>Language</span><select name="language" id="rule-language"><option value="">All languages</option>{languages.map((language) => <option value={language}>{languageLabel(language)}</option>)}</select></label>
            <label><span>Topic</span><select name="category" id="rule-category"><option value="">All topics</option>{categories.map((category) => <option value={category}>{topicLabel(category)}</option>)}</select></label>
            <label><span>Severity</span><select name="severity" id="rule-severity"><option value="">All severities</option>{SEVERITIES.map((severity) => <option value={severity}>{severity[0].toUpperCase() + severity.slice(1)}</option>)}</select></label>
            <label><span>Analysis</span><select name="analysis" id="rule-flow"><option value="">All analysis</option><option value="taint">Dataflow ({taintCount})</option><option value="pattern">Pattern</option></select></label>
          </div>
        </form>
      </div>
      <div class="results-bar" data-pagefind-ignore>
        <p id="rule-count-label" role="status" aria-live="polite">1–{Math.min(PAGE_SIZE, rules.length)} of {rules.length} rules</p>
        <button id="rule-reset" type="button" class="reset-filters" hidden><X size={14} aria-hidden="true" />Clear filters</button>
        <label class="sort-label"><span>Sort</span><select id="rule-sort"><option value="id">Rule ID</option><option value="severity">Severity</option></select></label>
      </div>
      <div class="rule-table-heading" aria-hidden="true"><span>Rule</span><span>Severity</span><span>Language</span></div>
      <ul id="rule-results" class="rule-list">
        {rules.map((r) => {
          const entry = catalogueEntry(r);
          return <li data-rule data-id={r.id} data-search={entry.search} data-severity={r.severity} data-languages={r.languages.join(',')} data-category={entry.category} data-mode={r.mode} data-flow={isTaint(r.id) ? 'true' : 'false'}>
            <a class="rule-row" href={'/rules/' + r.slug}>
              <div class="rule-summary"><div class="rule-identifier"><code>{r.id}</code>{r.mode === 'taint' && <span class="analysis-label">Dataflow</span>}</div><h2>{ruleTitle(r)}</h2><span class="rule-context">{topicLabel(entry.category)}{r.cwe && ' / ' + r.cwe}</span></div>
              <div class="row-severity"><SeverityBadge severity={r.severity} /></div>
              <span class="row-language">{r.languages.map(languageLabel).join(' / ')}</span>
              <ArrowUpRight class="row-arrow" size={16} aria-hidden="true" />
            </a>
          </li>;
        })}
      </ul>
      <div id="rule-empty" class="empty-state" hidden><Search size={28} aria-hidden="true" /><h2>No matching rules</h2><p>Try fewer filters, a shorter keyword, or a canonical rule ID.</p><button class="button" type="button" data-reset-rules>Clear all filters</button></div>
      <nav id="rule-pager" class="rule-pager" aria-label="Rule catalogue pages" data-pagefind-ignore hidden>
        <button id="rule-prev" type="button" class="button"><ArrowLeft size={16} aria-hidden="true" />Previous</button>
        <span id="rule-page-label"></span>
        <button id="rule-next" type="button" class="button">Next<ArrowRight size={16} aria-hidden="true" /></button>
      </nav>
      <div class="catalogue-note"><p><strong>Beyond pattern matching.</strong> <span class="analysis-badge">DATAFLOW</span> <strong>Dataflow analysis.</strong> {taintCount} rules trace untrusted input from source to a dangerous sink, catching multi-line bugs that pattern rules miss. <a href="/research">See the proof <ArrowRight size={15} aria-hidden="true" /></a></p><a href="/validation">Validation notes <ArrowRight size={15} aria-hidden="true" /></a></div>
    </main>
  </SiteChrome>
</Base>
<script>
  import '../../scripts/catalogue';
  // Catalogue filter predicate: row.dataset.flow === 'true' identifies dataflow analysis rows.
</script>
<style>
  .catalogue-heading { display: flex; gap: 24px; justify-content: space-between; align-items: end; }
  .catalogue-heading .eyebrow { margin-bottom: 10px; font-size: 13px; }
  .catalogue-heading .text-link { font-size: 13px; white-space: nowrap; margin-bottom: 4px; }
  .catalogue-toolbar { border-block: 1px solid var(--ol-border); padding: 20px 0; }
  .rule-search { display: flex; align-items: center; gap: 12px; border: 1px solid var(--ol-border-strong); border-radius: 4px; padding: 0 16px; background: var(--ol-surface); }
  .rule-search > svg { color: var(--ol-text-muted); }
  .rule-search:focus-within { border-color: var(--ol-accent); }
  .rule-search input { width: 100%; min-width: 0; background: none; color: var(--ol-text); border: 0; min-height: 48px; font-size: 15px; outline-offset: -2px; }
  input::placeholder { color: var(--ol-text-muted); }
  .filter-controls { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
  .filter-controls label { display: flex; align-items: center; gap: 8px; color: var(--ol-text-muted); font-size: 12px; min-width: 0; }
  select { border: 1px solid var(--ol-border); background: var(--ol-surface); color: var(--ol-text-secondary); height: 36px; max-width: 100%; border-radius: 4px; font-size: 13px; padding: 4px 28px 4px 10px; }
  .results-bar { display: flex; align-items: center; gap: 20px; min-height: 68px; color: var(--ol-text-muted); font-size: 13px; }
  .results-bar p { margin: 0; font-variant-numeric: tabular-nums; }
  .reset-filters { display: flex; align-items: center; gap: 5px; border: 0; background: none; color: var(--ol-accent); font-size: 12px; min-height: 36px; }
  .sort-label { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .sort-label select { background: transparent; border-color: transparent; }
  .rule-table-heading { display: grid; grid-template-columns: minmax(0, 1fr) 120px 168px; gap: 24px; padding: 10px 40px 10px 16px; color: var(--ol-text-muted); background: var(--ol-canvas); font-size: 12px; border-block: 1px solid var(--ol-border); }
  .rule-list { list-style: none; padding: 0; margin: 0; }
  .rule-row { display: grid; position: relative; grid-template-columns: minmax(0, 1fr) 120px 168px; gap: 24px; align-items: center; padding: 20px 40px 20px 16px; border-bottom: 1px solid var(--ol-border); text-decoration: none; }
  .rule-row:hover { background: var(--ol-surface); }
  .rule-summary { min-width: 0; }
  .rule-identifier { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 7px; }
  .rule-identifier code { color: var(--ol-accent); font-size: 11px; overflow-wrap: anywhere; }
  .analysis-label { font-size: 10px; color: var(--ol-text-muted); }
  .rule-summary h2 { font: 500 15px/1.5 var(--ol-font-ui); margin: 0 0 5px; overflow-wrap: anywhere; }
  .rule-context { color: var(--ol-text-muted); font-size: 11px; }
  .row-language { font-size: 12px; color: var(--ol-text-secondary); }
  .row-arrow { position: absolute; right: 8px; top: calc(50% - 8px); color: var(--ol-text-muted); opacity: 0; }
  .rule-row:hover .row-arrow, .rule-row:focus-visible .row-arrow { opacity: 1; }
  .rule-pager { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 24px; font-size: 13px; color: var(--ol-text-muted); }
  .rule-pager .button { min-height: 40px; font-size: 13px; padding: 8px 12px; }
  .empty-state { text-align: center; padding: 72px 20px; }
  .empty-state > svg { color: var(--ol-text-muted); margin-bottom: 20px; }
  .empty-state h2 { font-size: 22px; }
  .empty-state p { font-size: 14px; color: var(--ol-text-secondary); }
  .catalogue-note { border-top: 1px solid var(--ol-border); padding-top: 24px; margin-top: 24px; display: flex; align-items: center; gap: 48px; justify-content: space-between; color: var(--ol-text-muted); font-size: 13px; }
  .catalogue-note p { max-width: 76ch; margin: 0; }
  .catalogue-note strong { color: var(--ol-text-secondary); font-weight: 500; }
  .catalogue-note a { display: flex; gap: 8px; align-items: center; text-decoration: none; flex-shrink: 0; color: var(--ol-accent); }
  @media (max-width: 900px) { .filter-controls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); } .filter-controls label { display: grid; gap: 6px; } .rule-table-heading, .rule-row { grid-template-columns: minmax(0, 1fr) 94px 105px; gap: 16px; } .catalogue-note { flex-direction: column; align-items: flex-start; gap: 14px; } }
  @media (max-width: 600px) {
    .catalogue-heading { display: block; }
    .catalogue-heading .text-link { margin-top: 16px; }
    .catalogue-heading p { font-size: 16px; }
    .filter-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .filter-controls select { width: 100%; height: 40px; }
    .rule-table-heading { display: none; }
    .rule-row { grid-template-columns: minmax(0, 1fr) auto; gap: 12px; padding: 20px 0; }
    .rule-summary { grid-column: 1 / -1; }
    .row-language { text-align: right; }
    .row-arrow { display: none; }
    .results-bar { gap: 8px; flex-wrap: wrap; padding-block: 12px; }
    .sort-label > span { display: none; }
    .rule-pager { gap: 8px; }
    .rule-pager .button { padding: 8px; font-size: 12px; gap: 6px; }
  }
</style>
