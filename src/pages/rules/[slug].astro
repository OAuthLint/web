---
import { ArrowLeft, ArrowRight, ArrowUpRight, ChevronRight, GitBranch } from '@lucide/astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CopyButton from '../../components/CopyButton.astro';
import SeverityBadge from '../../components/SeverityBadge.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Base from '../../layouts/Base.astro';
import { languageLabel, ruleTitle, topicLabel, topicSlug } from '../../lib/catalogue';
import { renderInline, stripInline, titleAndBody } from '../../lib/inline';
import { cweUrl, owaspUrl } from '../../lib/references';
import { type RuleView, getRules } from '../../lib/rules';

export function getStaticPaths() {
  return getRules().map((rule) => ({ params: { slug: rule.slug }, props: { rule } }));
}
interface Props {
  rule: RuleView;
}
const { rule } = Astro.props;
const title = ruleTitle(rule);
const category = topicSlug(rule.id);
const topic = topicLabel(category);
const TAINT_RULE_IDS = new Set<string>([
  'auth.flow.open-redirect',
  'auth.flow.secret-in-response',
  'auth.flow.ssrf',
  'auth.go.flow.open-redirect',
  'auth.go.flow.secret-in-response',
  'auth.go.flow.ssrf',
  'auth.oauth.open-redirect-callback',
  'auth.py.flow.open-redirect',
  'auth.py.flow.secret-in-response',
  'auth.py.flow.ssrf',
]);
const isTaint = TAINT_RULE_IDS.has(rule.id);
const PREV: Record<'HIGH' | 'MEDIUM' | 'LOW', { label: string; color: string }> = {
  HIGH: { label: 'HIGH', color: 'var(--ol-sev-critical)' },
  MEDIUM: { label: 'MED', color: 'var(--ol-text-secondary)' },
  LOW: { label: 'LOW', color: 'var(--ol-text-muted)' },
};
const prev = PREV[rule.llmPrevalence];
const { body } = titleAndBody(rule.message);
const cwe = rule.cwe ? cweUrl(rule.cwe) : undefined;
const owasp = rule.owasp ? owaspUrl(rule.owasp) : undefined;
const related = getRules()
  .filter(
    (candidate) =>
      candidate.id !== rule.id &&
      topicSlug(candidate.id) === category &&
      candidate.languages.some((language) => rule.languages.includes(language)),
  )
  .slice(0, 3);
const canonical = `https://oauthlint.dev/rules/${rule.slug}`;
const article = {
  '@type': 'TechArticle',
  headline: title,
  description: stripInline(rule.title),
  url: canonical,
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'Auspeo' },
  publisher: { '@id': 'https://oauthlint.dev/#org' },
  keywords: [rule.id, rule.ruleId, rule.cwe, rule.owasp].filter(Boolean).join(', '),
};
---
<Base title={title + ' | OAuthLint'} description={rule.id + ': ' + stripInline(rule.title)} ogType="article" jsonLd={article}>
  <SiteChrome active="rules">
    <main id="main" class="container rule-detail" data-pagefind-body>
      <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore><a href="/rules">Rules</a><ChevronRight size={12} aria-hidden="true" /><a href={'/rules?category=' + category}>{topic}</a><ChevronRight size={12} aria-hidden="true" /><span>{rule.ruleId}</span></nav>
      <header class="rule-heading">
        <div class="rule-tags"><SeverityBadge severity={rule.severity} /><span>{rule.languages.map(languageLabel).join(' / ')}</span><span title="How often AI coding tools generate this anti-pattern by default" class="ai-prevalence-badge">AI: {prev.label}</span>{isTaint && <span class="dataflow-tag" title="Dataflow rule. Traces untrusted/sensitive data from source to a dangerous sink."><GitBranch size={14} aria-hidden="true" />DATAFLOW</span>}</div>
        <h1>{title}</h1>
        <div class="rule-id"><code>{rule.id}</code><CopyButton value={rule.id} label="Copy rule ID" /></div>
      </header>
      <div class="rule-layout">
        <article class="rule-content">
          <section id="explanation" class="prose"><h2>Why it matters</h2><p set:html={renderInline(rule.title)} />{body.map((block) => block.type === 'ul' ? <ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul> : <p set:html={renderInline(block.text)} />)}</section>
          <section id="examples" class="rule-examples">
            <div class="example-heading"><h2>Code examples</h2><span>From the rule's test fixtures</span></div>
            {rule.vulnerable && <div class="fixture"><h3><span class="fixture-marker danger"></span>Triggers this rule</h3><CodeBlock code={rule.vulnerable.code} language={rule.vulnerable.language} filename={rule.vulnerable.filename} label="Vulnerable" tone="danger" /></div>}
            {rule.safe && <div class="fixture"><h3><span class="fixture-marker success"></span>Does not trigger this rule</h3><CodeBlock code={rule.safe.code} language={rule.safe.language} filename={rule.safe.filename} label="Passing fixture" tone="success" /></div>}
            <p class="fixture-note">A passing fixture demonstrates the scope of this rule. It is not a guarantee that an application is secure.</p>
          </section>
          <section id="adoption" class="prose"><h2>Use this finding in your workflow</h2><p>Severity describes the diagnostic. Your configuration decides whether it blocks a build. The CLI's default failure threshold is <code>HIGH</code>.</p><p>For an intentional exception, use a narrowly scoped suppression with a reason, or capture a baseline when adopting OAuthLint in an existing project.</p><div class="related-docs"><a href="/docs/suppressing">Scoped suppressions <ArrowRight size={14} aria-hidden="true" /></a><a href="/docs/cli#baseline">Baselines <ArrowRight size={14} aria-hidden="true" /></a><a href="/docs/configuration">Configure thresholds <ArrowRight size={14} aria-hidden="true" /></a></div></section>
          {rule.references.length > 0 && <section id="references" class="prose"><h2>References</h2><ul class="reference-list">{rule.references.filter((url) => /^https?:\/\//.test(url)).map((url) => <li><a href={url} target="_blank" rel="noopener noreferrer">{url}<ArrowUpRight size={14} aria-hidden="true" /></a></li>)}</ul></section>}
        </article>
        <aside class="rule-rail" aria-label="Rule details" data-pagefind-ignore>
          <h2>Rule details</h2>
          <dl><div><dt>Rule ID</dt><dd>{rule.ruleId}</dd></div><div><dt>Severity</dt><dd><SeverityBadge severity={rule.severity} /></dd></div><div><dt>Analysis</dt><dd>{isTaint ? 'Dataflow' : 'Pattern'}</dd></div>{rule.cwe && <div><dt>CWE</dt><dd>{cwe ? <a href={cwe} target="_blank" rel="noopener noreferrer">{rule.cwe}<ArrowUpRight size={12} aria-hidden="true" /></a> : rule.cwe}</dd></div>}{rule.owasp && <div><dt>OWASP</dt><dd>{owasp ? <a href={owasp} target="_blank" rel="noopener noreferrer">{rule.owasp}<ArrowUpRight size={12} aria-hidden="true" /></a> : rule.owasp}</dd></div>}<div><dt>AI prevalence</dt><dd>{rule.llmPrevalence.toLowerCase()}</dd></div></dl>
          <p class="rail-note">AI prevalence is a tag in the rule metadata, not a measured probability for your code.</p>
          <nav aria-label="On this rule"><a href="#explanation">Why it matters</a><a href="#examples">Code examples</a><a href="#adoption">Use in your workflow</a>{rule.references.length > 0 && <a href="#references">References</a>}</nav>
          <a class="rail-back" href="/rules"><ArrowLeft size={14} aria-hidden="true" />All rules</a>
        </aside>
      </div>
      {related.length > 0 && <section class="related-rules" data-pagefind-ignore><h2>Related {topic} checks</h2><div>{related.map((entry) => <a href={'/rules/' + entry.slug}><code>{entry.id}</code><span>{ruleTitle(entry)}</span><ArrowUpRight size={15} aria-hidden="true" /></a>)}</div></section>}
    </main>
  </SiteChrome>
</Base>
<style>
  .rule-detail { padding-top: 36px; }
  .rule-heading { max-width: 900px; margin-bottom: 40px; }
  .rule-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 18px; }
  .rule-tags > span { font-size: 12px; color: var(--ol-text-muted); }
  .dataflow-tag { display: inline-flex; align-items: center; gap: 6px; }
  h1 { font-size: 34px; font-weight: 600; line-height: 1.3; margin-bottom: 14px; overflow-wrap: anywhere; }
  .rule-id { display: flex; align-items: center; gap: 8px; color: var(--ol-text-muted); }
  .rule-id code { font-size: 12px; overflow-wrap: anywhere; }
  .rule-layout { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 64px; }
  .rule-content { min-width: 0; }
  .rule-content h2 { font-size: 22px; font-weight: 600; }
  #explanation h2 { margin-top: 0; }
  .rule-examples { margin-top: 40px; }
  .example-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .example-heading h2 { margin: 0; }
  .example-heading > span { color: var(--ol-text-muted); font-size: 12px; }
  .fixture { margin-bottom: 24px; }
  .fixture h3 { display: flex; gap: 8px; align-items: center; font: 500 13px var(--ol-font-ui); margin-bottom: 10px; }
  .fixture-marker { width: 6px; height: 6px; border-radius: 50%; }
  .danger { background: var(--ol-sev-critical); }
  .success { background: var(--ol-sev-pass); }
  .fixture-note { color: var(--ol-text-muted); font-size: 12px; }
  .rule-rail { align-self: start; position: sticky; top: 104px; border-left: 1px solid var(--ol-border); padding-left: 24px; }
  .rule-rail h2 { font: 600 13px var(--ol-font-ui); margin-bottom: 24px; }
  dl { margin: 0; }
  dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 18px; font-size: 12px; }
  dt { color: var(--ol-text-muted); flex-shrink: 0; }
  dd { margin: 0; text-align: right; overflow-wrap: anywhere; }
  dd a { display: inline-flex; gap: 4px; align-items: center; text-decoration: none; color: var(--ol-accent); }
  .rail-note { font-size: 11px; line-height: 1.7; color: var(--ol-text-muted); margin: 24px 0; }
  .rule-rail nav { display: grid; gap: 12px; border-top: 1px solid var(--ol-border); padding-top: 20px; }
  .rule-rail nav a { text-decoration: none; color: var(--ol-text-secondary); font-size: 13px; }
  .rule-rail nav a:hover { color: var(--ol-accent); }
  .rail-back { display: flex; align-items: center; gap: 8px; margin-top: 28px; color: var(--ol-accent); text-decoration: none; font-size: 13px; }
  .related-docs { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 13px; }
  .related-docs a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
  .reference-list { list-style: none; padding: 0 !important; }
  .reference-list a { display: inline; font-size: 13px; overflow-wrap: anywhere; }
  .reference-list svg { display: inline; margin-left: 4px; vertical-align: middle; }
  .related-rules { border-top: 1px solid var(--ol-border); margin-top: 64px; padding-top: 32px; }
  .related-rules h2 { font-size: 20px; margin-bottom: 24px; }
  .related-rules > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .related-rules a { position: relative; padding-right: 20px; text-decoration: none; }
  .related-rules code { display: block; color: var(--ol-accent); font-size: 10px; overflow-wrap: anywhere; margin-bottom: 8px; }
  .related-rules span { font-size: 13px; line-height: 1.6; display: block; }
  .related-rules svg { position: absolute; right: 0; top: 0; }
  @media (max-width: 1000px) { .rule-layout { gap: 32px; grid-template-columns: minmax(0, 1fr) 210px; } .rule-rail { padding-left: 20px; } }
  @media (max-width: 760px) { h1 { font-size: 28px; } .rule-layout { display: flex; flex-direction: column; gap: 32px; } .rule-rail { position: static; border-left: 0; border-top: 1px solid var(--ol-border); padding: 24px 0 0; width: 100%; } .rule-rail nav, .rail-back { display: none; } .related-rules > div { grid-template-columns: 1fr; gap: 24px; } .rule-heading { margin-bottom: 28px; } .rule-detail { padding-top: 24px; } }
</style>
