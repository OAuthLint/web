---
import { ArrowLeft, ArrowRight, ChevronDown, ChevronRight, List, PanelLeft } from '@lucide/astro';
import CopyButton from '../components/CopyButton.astro';
import DocsNavigation from '../components/DocsNavigation.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Unavailable from '../components/Unavailable.astro';
import { SHOW_CLOUD, WEB_GITHUB_URL, isCloudPath } from '../config';
import { DOCS_NAV } from '../data/docs-nav';
import Base from './Base.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  frontmatter?: { title?: string; description?: string; section?: string };
  title?: string;
  description?: string;
  section?: string;
  headings?: Heading[];
}
const fm = Astro.props.frontmatter ?? {};
const section = Astro.props.section ?? fm.section ?? '';
const pageTitle = Astro.props.title ?? fm.title ?? 'Documentation';
const description = Astro.props.description ?? fm.description;
const toc = (Astro.props.headings ?? []).filter((heading) => heading.depth === 2);
const pathname = Astro.url.pathname.replace(/\/$/, '');
const unavailable = isCloudPath(pathname) && !SHOW_CLOUD;
const activeGroup = DOCS_NAV.find((group) => group.items.some((item) => item.key === section));
const visibleItems = DOCS_NAV.filter(
  (group) => SHOW_CLOUD || group.group !== 'OAuthLint Cloud',
).flatMap((group) => group.items);
const index = visibleItems.findIndex((item) => item.key === section);
const previous = visibleItems[index - 1];
const next = visibleItems[index + 1];
const slug = pathname === '/docs' ? 'index' : pathname.replace(/^\/docs\//, '');
const editHref = `${WEB_GITHUB_URL}/edit/main/src/pages/docs/${slug}.md`;
---
<Base title={pageTitle + ' | OAuthLint documentation'} description={description}>
  <SiteChrome active="docs">
    {unavailable ? <Unavailable /> : <>
      <div class="docs-mobile">
        <details data-disclosure><summary><PanelLeft size={16} aria-hidden="true" /> Documentation <ChevronDown size={14} aria-hidden="true" /></summary><div class="docs-mobile-panel"><DocsNavigation section={section} /></div></details>
        {toc.length > 0 && <details data-disclosure><summary><List size={16} aria-hidden="true" /> On this page <ChevronDown size={14} aria-hidden="true" /></summary><nav class="docs-mobile-panel" aria-label="Mobile table of contents">{toc.map((heading) => <a href={'#' + heading.slug}>{heading.text}</a>)}</nav></details>}
      </div>
      <div class="docs-grid">
        <aside class="docs-sidebar"><DocsNavigation section={section} /></aside>
        <main id="main" class="docs-main" data-pagefind-body>
          <div class="breadcrumb" data-pagefind-ignore><a href="/docs">Docs</a><ChevronRight size={12} aria-hidden="true" /><span>{activeGroup?.group ?? 'Reference'}</span></div>
          {isCloudPath(pathname) && <p class="note" data-pagefind-ignore>This guide describes a planned Cloud workflow. It is not a currently available service.</p>}
          <article class="prose"><slot /></article>
          <div class="docs-edit" data-pagefind-ignore><a href={editHref} target="_blank" rel="noopener noreferrer">Edit this page on GitHub</a><a href="https://github.com/OAuthLint/web/issues">Report a documentation issue</a></div>
          <nav class="docs-pagination" aria-label="Documentation pages" data-pagefind-ignore>
            {previous ? <a href={previous.href}><ArrowLeft size={16} aria-hidden="true" /><span><small>Previous</small>{previous.label}</span></a> : <span />}
            {next && <a class="next" href={next.href}><span><small>Next</small>{next.label}</span><ArrowRight size={16} aria-hidden="true" /></a>}
          </nav>
        </main>
        <aside class="docs-toc">{toc.length > 0 && <><h2>On this page</h2><nav aria-label="On this page">{toc.map((heading) => <a href={'#' + heading.slug}>{heading.text}</a>)}</nav></>}</aside>
      </div>
      <template id="code-copy-template"><CopyButton /></template>
    </>}
  </SiteChrome>
</Base>
<script>
  import '../scripts/docs';
</script>
<style>
  .docs-grid { display: grid; grid-template-columns: 224px minmax(0, 740px) 184px; gap: 48px; max-width: 1440px; padding: 0 32px; margin: auto; justify-content: center; }
  .docs-sidebar, .docs-toc { position: sticky; top: 72px; align-self: start; max-height: calc(100dvh - 72px); overflow-y: auto; padding-block: 36px; scrollbar-width: thin; }
  .docs-sidebar { border-right: 1px solid var(--ol-border); padding-right: 24px; padding-left: 12px; }
  .docs-main { min-width: 0; padding: 36px 0 16px; }
  .docs-main .breadcrumb { margin-bottom: 28px; }
  .docs-toc h2 { font: 600 12px var(--ol-font-ui); margin: 0 0 14px; }
  .docs-toc nav { display: grid; gap: 12px; }
  .docs-toc a { font-size: 13px; line-height: 1.5; text-decoration: none; color: var(--ol-text-muted); border-left: 1px solid var(--ol-border); padding-left: 12px; }
  .docs-toc a[aria-current], .docs-toc a:hover { color: var(--ol-accent); border-color: var(--ol-accent); }
  .docs-edit { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--ol-border); margin-top: 48px; padding-top: 24px; font-size: 13px; color: var(--ol-text-muted); }
  .docs-pagination { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; margin-top: 32px; }
  .docs-pagination a { display: flex; align-items: center; gap: 12px; text-decoration: none; padding-block: 14px; color: var(--ol-text-secondary); font-size: 14px; }
  .docs-pagination a:hover { color: var(--ol-accent); }
  .docs-pagination small { display: block; font-size: 12px; color: var(--ol-text-muted); margin-bottom: 4px; }
  .docs-pagination .next { justify-content: flex-end; text-align: right; }
  .docs-mobile { display: none; }
  :global(.doc-code) { position: relative; margin: 20px 0 24px; }
  :global(.doc-code pre) { margin: 0; padding-top: 46px; }
  :global(.doc-code > button) { position: absolute; right: 6px; top: 4px; }
  @media (max-width: 1200px) { .docs-grid { grid-template-columns: 210px minmax(0, 740px); gap: 36px; } .docs-toc { display: none; } }
  @media (max-width: 900px) {
    .docs-grid { display: block; max-width: 800px; padding-inline: 24px; }
    .docs-sidebar { display: none; }
    .docs-main { padding-top: 28px; }
    .docs-mobile { display: flex; justify-content: space-between; position: sticky; top: 72px; z-index: 30; border-bottom: 1px solid var(--ol-border); background: var(--ol-page); padding-inline: 20px; }
    .docs-mobile summary { display: flex; align-items: center; gap: 8px; min-height: 48px; font-size: 13px; color: var(--ol-text-secondary); }
    .docs-mobile-panel { position: absolute; top: 100%; left: 0; right: 0; max-height: calc(100dvh - 130px); overflow-y: auto; padding: 24px 32px; border-bottom: 1px solid var(--ol-border); background: var(--ol-page); box-shadow: var(--ol-elev-2); }
    nav.docs-mobile-panel a { display: block; padding: 12px 0; font-size: 14px; text-decoration: none; }
  }
  @media (max-width: 800px) { .docs-mobile { top: 64px; } }
  @media (max-width: 480px) { .docs-grid { padding-inline: 20px; } .docs-pagination { gap: 16px; } }
  @media print { .docs-sidebar, .docs-toc, .docs-mobile, .docs-edit, .docs-pagination { display: none; } .docs-grid { display: block; } }
</style>
