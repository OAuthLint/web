---
import ArticleLayout from './ArticleLayout.astro';
interface Props {
  frontmatter?: { title?: string; description?: string; active?: string };
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? 'OAuthLint';
---
<ArticleLayout title={title} description={Astro.props.description ?? fm.description} active={fm.active} headings={Astro.props.headings}><slot /></ArticleLayout>
