---
import '@fontsource-variable/sora';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/martian-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import { CLOUD_PREVIEW, isIndexablePath } from '../config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = 'Open-source authentication security checks for your editor, terminal and CI. Find OAuth, JWT, session and MCP mistakes with actionable diagnostics.',
  ogImage = '/og.png',
  ogImageAlt = 'OAuthLint authentication security checks',
  ogType = 'website',
  noindex = false,
  jsonLd: extra,
} = Astro.props;
const site = Astro.site?.href ?? 'https://oauthlint.dev/';
const canonical = new URL(Astro.url.pathname, site).href;
const indexable = !noindex && isIndexablePath(Astro.url.pathname);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#org`,
      name: 'Auspeo',
      url: site,
      logo: new URL('/logo.svg', site).href,
    },
    { '@type': 'WebSite', '@id': `${site}#website`, name: 'OAuthLint', url: site, description },
    {
      '@type': 'SoftwareApplication',
      name: 'OAuthLint',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      url: site,
      license: 'https://opensource.org/licenses/MIT',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    ...(extra ? (Array.isArray(extra) ? extra : [extra]) : []),
  ],
};
// JSON-LD is script content, so escape '<' even when the data is build-owned.
const structuredData = JSON.stringify(graph).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Auspeo" />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#101214" />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('ol-theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="OAuthLint" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site).href} />
    {import.meta.env.PROD && !CLOUD_PREVIEW && import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN })} is:inline />
    )}
    {import.meta.env.PROD && !CLOUD_PREVIEW && (
      <script is:inline>
        if (location.hostname === 'oauthlint.dev') {
          const script = document.createElement('script');
          script.defer = true;
          script.src = '/stats/script.js';
          script.dataset.websiteId = '737636e5-694e-47ab-92ad-1cb943a94065';
          script.dataset.hostUrl = 'https://oauthlint.dev/stats';
          document.head.append(script);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {CLOUD_PREVIEW ? <div class="preview-banner">Cloud preview. Features and commercial terms are not yet available.</div> : <AnnouncementBar />}
    <slot />
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
  </body>
</html>
<script>
  import '../scripts/site';
</script>
