---
import { Check, Copy } from '@lucide/astro';
interface Props {
  value?: string;
  target?: string;
  label?: string;
}
const { value, target, label = 'Copy code' } = Astro.props;
---
<button type="button" class="icon-button copy-button" data-copy-value={value} data-copy-target={target} aria-label={label} title={label}>
  <Copy size={16} class="copy-icon" aria-hidden="true" />
  <Check size={16} class="copied-icon" aria-hidden="true" />
</button>
