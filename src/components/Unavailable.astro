---
import { ArrowRight, Cloud } from '@lucide/astro';
interface Props {
  title?: string;
}
const { title = 'OAuthLint Cloud is not available yet' } = Astro.props;
---
<main id="main" class="container unavailable" data-pagefind-ignore="all">
  <Cloud size={32} aria-hidden="true" />
  <h1>{title}</h1>
  <p>The open-source CLI, editor extension and rules are available now. Cloud documentation and services will be published when they are ready.</p>
  <a class="button button-primary" href="/docs">Start with the CLI <ArrowRight size={16} aria-hidden="true" /></a>
  <a class="text-link" href="/rules">Explore the rules</a>
</main>
<style>
  .unavailable { max-width: 760px; padding-block: 80px; min-height: 50vh; }
  .unavailable > svg { color: var(--ol-accent); margin-bottom: 24px; }
  h1 { font-size: 32px; }
  p { color: var(--ol-text-secondary); max-width: 60ch; margin-bottom: 28px; }
  .text-link { margin: 16px 0 0 20px; }
  @media (max-width: 480px) { h1 { font-size: 26px; } .text-link { display: flex; margin-left: 0; } }
</style>
