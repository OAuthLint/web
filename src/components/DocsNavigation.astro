---
import { SHOW_CLOUD } from '../config';
import { DOCS_NAV } from '../data/docs-nav';
interface Props {
  section: string;
}
const { section } = Astro.props;
const groups = DOCS_NAV.filter((group) => SHOW_CLOUD || group.group !== 'OAuthLint Cloud');
---
<nav class="docs-tree" aria-label="Documentation">
  {groups.map((group) => <div class="docs-group"><h2>{group.group}</h2><ul>{group.items.map((item) => <li><a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a></li>)}</ul></div>)}
</nav>
<style>
  .docs-group { margin-bottom: 28px; }
  h2 { font: 600 13px var(--ol-font-ui); margin: 0 0 10px; color: var(--ol-text); }
  ul { list-style: none; padding: 0; margin: 0; }
  a { display: block; padding: 7px 12px; margin-left: -12px; font-size: 14px; line-height: 1.45; text-decoration: none; color: var(--ol-text-secondary); border-left: 2px solid transparent; }
  a:hover { color: var(--ol-text); background: var(--ol-surface-raised); }
  a[aria-current] { color: var(--ol-accent); background: var(--ol-accent-subtle); border-left-color: var(--ol-accent); font-weight: 600; border-radius: 0 3px 3px 0; }
  @media (max-width: 900px) { a { min-height: 44px; padding-block: 12px; } }
</style>
